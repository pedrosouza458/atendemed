{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atende-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "APP_ORIGIN": "http://localhost:5173" },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SEARCH_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "r2_buckets": [
    { "binding": "DOCUMENTS", "bucket_name": "atende-medical-documents" }
  ]
}
